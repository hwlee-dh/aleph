# 이 파일을 `.env`로 복사한 뒤, 가진 키만 채우면 된다. 빈 줄은 그대로 둬도 된다.
# 키는 앱의 설정 화면에서 입력해도 되고(그 경우 data/config/providers.json에 저장),
# 여기 적어도 된다. 둘 다 있으면 설정 화면에서 입력한 값이 우선한다.

# Google Gemini API (aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Anthropic Claude API (console.anthropic.com)
ANTHROPIC_API_KEY=

# Google Cloud Vertex AI
# 서비스 계정 키(JSON)는 설정 화면에서 붙여 넣거나 파일을 골라 넣는 게 기본이다.
# 파일 경로로 주고 싶으면 여기에 적는다. 프로젝트 ID는 그 파일에서 읽는다.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_LOCATION=global
# 아래는 다른 방식으로 붙을 때만: 프로젝트 ID를 직접 지정하거나, 익스프레스 모드 API 키를 쓰는 경우
GOOGLE_CLOUD_PROJECT=
VERTEX_API_KEY=

# 아래는 실제 호출 검증이 안 된 제공자들
OPENAI_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=

# 데이터 폴더를 다른 곳에 두고 싶을 때만 (기본: 저장소의 data/)
# ALEPH_DATA_DIR=
